        no: '04',
        company: 'Skild AI',
        role: 'Office Coordinator',
        period: '10.2024 — 06.2025  ·  SAN MATEO, CA',
        color: '#7AE68A',
        planetColor: 0x7AE68A,
        pos: [-2.8, -2.2, -4],
        size: 0.40,
        stats: [
          { val: '5+',   lbl: 'Vendors coordinated\nsimultaneously' },
          { val: '100%', lbl: 'SOPs written across\nall workflows' },
          { val: 'KPI',  lbl: 'Throughput, latency\n& cycle time tracked' },
          { val: 'QA',   lbl: 'Labeling protocols\nstandardized team-wide' },
        ],
        narrative: 'First ops hire at a fast-growing robotics AI startup. Built all operational infrastructure from nothing — vendor relationships, office logistics, SOPs, QA protocols, and KPI tracking. The scaffolding that lets a fast-moving technical team actually ship without falling apart.',
        tools: ['SOP Authoring', 'KPI Tracking', 'Vendor Management', 'QA Protocols', 'Google Workspace', 'Inventory Systems'],
      },
      {
        id: 'space',
        label: '∞',
        domain: 'NEXT FRONTIER',
        no: '05',
        company: 'Space Technology',
        role: 'Where I\'m Headed',
        period: 'THE NEAR FUTURE  ·  OPEN TO WORK',
        color: '#B57BFF',
        planetColor: 0xB57BFF,
        pos: [2.4, 1.2, -9],
        size: 0.72,
        stats: [
          { val: '4',    lbl: 'Industries built across\ndiamond · AI · robotics · materials' },
          { val: '→',    lbl: 'Same instinct:\nfind what\'s broken, fix it' },
          { val: 'OPS',  lbl: 'Production systems\nas the common thread' },
          { val: '🚀',   lbl: 'Next chapter:\nspace technology company' },
        ],
        narrative: 'I\'ve built operations in places most people haven\'t — CVD diamond labs, AI pipelines, robotic deployments, advanced materials production. Different industries, same instinct: understand the system, find what\'s broken, make it better. The next frontier I want to work in is space.',
        tools: ['Production Operations', 'AI Automation', 'Data Analysis', 'Systems Thinking', 'Cross-Domain Expertise'],
      },
      {
        id: 'about',
        label: 'LJ',
        domain: 'ABOUT',
        no: '06',
        company: 'Lavanya Joshi',
        role: 'Operations · AI · Diamond · Space',
        period: '2026  ·  BAY AREA',
        color: '#FFD166',
        planetColor: 0xFFD166,
        pos: [0, -0.4, -1.2],
        size: 0.30,
        stats: [
          { val: 'B.S.', lbl: 'MIS · San Jose State\nGPA 4.0' },
          { val: 'PSM',  lbl: 'Professional Scrum\nMaster I' },
          { val: 'VP',   lbl: 'Women in Business\nSJSU Robotics Team Mgr' },
          { val: '✉',    lbl: 'lavanya.joshi40\n@gmail.com' },
        ],
        narrative: 'SJSU Management Information Systems, GPA 4.0. VP of Women in Business, Team Manager at SJSU Robotics, Finance Manager at Dance Team. Professional Scrum Master I certified. Available for roles in space technology, advanced manufacturing, and AI-driven operations.',
        tools: ['lavanya.joshi40@gmail.com', 'linkedin.com/in/lavanya-joshi', 'github.com/lavj1462'],
      },
    ];

    /* ══════════════════════════════════════
       SCENE
    ══════════════════════════════════════ */
    const canvas = document.getElementById('space');
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setSize(innerWidth, innerHeight);
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(58, innerWidth / innerHeight, 0.1, 600);
    camera.position.set(0, 0, 8);

    scene.add(new THREE.AmbientLight(0xffffff, 0.12));

    /* ── glow texture helper ── */
    function makeGlowTex(hexInt) {
      const sz = 128, c = sz / 2;
      const cv = document.createElement('canvas');
      cv.width = cv.height = sz;
      const ctx = cv.getContext('2d');
      const r = (hexInt >> 16) & 255, g = (hexInt >> 8) & 255, b = hexInt & 255;
      const gr = ctx.createRadialGradient(c, c, 0, c, c, c);
      gr.addColorStop(0,   `rgba(${r},${g},${b},1)`);
      gr.addColorStop(0.25,`rgba(${r},${g},${b},0.5)`);
      gr.addColorStop(1,   `rgba(${r},${g},${b},0)`);
      ctx.fillStyle = gr;
      ctx.fillRect(0, 0, sz, sz);
      return new THREE.CanvasTexture(cv);
    }

    /* ── stars ── */
    const starCount = 9000;
    const starPos = new Float32Array(starCount * 3);
    const starSize = new Float32Array(starCount);
    for (let i = 0; i < starCount; i++) {
      starPos[i*3]   = (Math.random() - 0.5) * 400;
      starPos[i*3+1] = (Math.random() - 0.5) * 400;
      starPos[i*3+2] = (Math.random() - 0.5) * 400;
      starSize[i] = 0.4 + Math.random() * 1.4;
    }
    const starGeo = new THREE.BufferGeometry();
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
    starGeo.setAttribute('aSize',    new THREE.BufferAttribute(starSize, 1));

    const starMat = new THREE.ShaderMaterial({
      uniforms: { uTime: { value: 0 } },
      vertexShader: `
        attribute float aSize;
        uniform float uTime;
        varying float vAlpha;
        void main() {
          vec4 mv = modelViewMatrix * vec4(position, 1.0);
          float flicker = 0.7 + 0.3 * sin(uTime * 1.8 + position.x * 3.1 + position.y * 2.7);
          vAlpha = flicker;
          gl_PointSize = aSize * flicker * (280.0 / -mv.z);
          gl_Position = projectionMatrix * mv;
        }
      `,
      fragmentShader: `
        varying float vAlpha;
        void main() {
          float d = length(gl_PointCoord - 0.5) * 2.0;
          float a = 1.0 - smoothstep(0.3, 1.0, d);
          gl_FragColor = vec4(1.0, 0.98, 0.96, a * vAlpha);
        }
      `,
      transparent: true,
      depthWrite: false,
    });
    scene.add(new THREE.Points(starGeo, starMat));

    /* ── nebula sprites ── */
    const nebulaDefs = [
      { color: 0x1a0a4a, x: -30, y:  15, z: -80, sx: 90, sy: 70, op: 0.18 },
      { color: 0x0a1a3a, x:  40, y: -20, z: -90, sx: 80, sy: 60, op: 0.14 },
      { color: 0x0d0a25, x: -10, y: -35, z: -70, sx: 60, sy: 50, op: 0.12 },
      { color: 0x150a30, x:  20, y:  30, z: -85, sx: 70, sy: 55, op: 0.10 },
    ];
    nebulaDefs.forEach(d => {
      const nc = document.createElement('canvas');
      nc.width = nc.height = 256;
      const nctx = nc.getContext('2d');
      const nr = (d.color >> 16) & 255, ng = (d.color >> 8) & 255, nb = d.color & 255;
      const ngr = nctx.createRadialGradient(128, 128, 0, 128, 128, 128);
      ngr.addColorStop(0,   `rgba(${nr},${ng},${nb},1)`);
      ngr.addColorStop(0.5, `rgba(${nr},${ng},${nb},0.3)`);
      ngr.addColorStop(1,   `rgba(${nr},${ng},${nb},0)`);
      nctx.fillStyle = ngr;
      nctx.fillRect(0, 0, 256, 256);
      const nspr = new THREE.Sprite(new THREE.SpriteMaterial({
        map: new THREE.CanvasTexture(nc),
        blending: THREE.AdditiveBlending,
        transparent: true,
        opacity: d.op,
        depthWrite: false,
      }));
      nspr.position.set(d.x, d.y, d.z);
      nspr.scale.set(d.sx, d.sy, 1);
      scene.add(nspr);
    });

    /* ── planets ── */
    const meshes = [], glows = [], lights = [];

    NODES.forEach(node => {
      const geo = new THREE.SphereGeometry(node.size, 40, 40);
      const mat = new THREE.MeshStandardMaterial({
        color: node.planetColor,
        emissive: node.planetColor,
        emissiveIntensity: 0.22,
        roughness: 0.65,
        metalness: 0.05,
      });
      const mesh = new THREE.Mesh(geo, mat);
      mesh.position.set(...node.pos);
      mesh.userData.nodeId = node.id;
      scene.add(mesh);
      meshes.push(mesh);

      const glow = new THREE.Sprite(new THREE.SpriteMaterial({
        map: makeGlowTex(node.planetColor),
        color: node.planetColor,
        blending: THREE.AdditiveBlending,
        transparent: true,
        opacity: 0.35,
        depthWrite: false,
      }));
      glow.scale.set(node.size * 4.5, node.size * 4.5, 1);
      glow.position.set(...node.pos);
      scene.add(glow);
      glows.push(glow);

      const light = new THREE.PointLight(node.planetColor, 1.8, node.size * 10);
      light.position.set(...node.pos);
      scene.add(light);
      lights.push(light);
    });

    /* ── labels ── */
    const labelsWrap = document.getElementById('labels');
    const labelEls = NODES.map(node => {
      const d = document.createElement('div');
      d.className = 'nlabel';
      d.dataset.id = node.id;
      d.innerHTML = `<span class="nlabel__name">${node.label}</span><span class="nlabel__sub">${node.domain}</span>`;
      labelsWrap.appendChild(d);
      return d;
    });

    /* ══════════════════════════════════════
       INTERACTION
    ══════════════════════════════════════ */
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();
    let hoveredIdx = -1;
    let panelOpen = false;
    const camHome = new THREE.Vector3(0, 0, 8);

    window.addEventListener('mousemove', e => {
      mouse.x =  (e.clientX / innerWidth)  * 2 - 1;
      mouse.y = -(e.clientY / innerHeight) * 2 + 1;
    });

    window.addEventListener('click', () => {
      if (panelOpen || hoveredIdx < 0) return;
      const node = NODES[hoveredIdx];

      // camera zoom toward planet
      const target = new THREE.Vector3(...node.pos);
      const dir = target.clone().sub(camera.position).normalize();
      const dest = target.clone().sub(dir.multiplyScalar(node.size * 3.2 + 1.6));

      gsap.to(camera.position, {
        x: dest.x, y: dest.y, z: dest.z,
        duration: 1.1,
        ease: 'power2.inOut',
        onComplete: () => openPanel(node),
      });
    });

    function openPanel(node) {
      panelOpen = true;
      const panel = document.getElementById('panel');
      panel.style.setProperty('--accent', node.color);

      // populate
      document.getElementById('panel-ghost').textContent  = node.company;
      document.getElementById('panel-no').textContent     = `${node.no} / ${node.domain}`;
      document.getElementById('pd-domain').textContent    = node.domain;
      document.getElementById('pd-company').textContent   = node.company;
      document.getElementById('pd-role').textContent      = node.role;
      document.getElementById('pd-period').textContent    = node.period;
      document.getElementById('pd-narrative').textContent = node.narrative;

      document.getElementById('pd-stats').innerHTML = node.stats.map(s => `
        <div class="stat">
          <span class="stat__val">${s.val}</span>
          <span class="stat__lbl">${s.lbl.replace(/\n/g,'<br/>')}</span>
        </div>
      `).join('');

      document.getElementById('pd-tools').innerHTML = node.tools.map(t =>
        `<span class="tool-chip">${t}</span>`
      ).join('');

      // show + animate
      panel.style.display = 'flex';
      panel.setAttribute('aria-hidden', 'false');
      gsap.set(panel, { opacity: 0 });

      const tl = gsap.timeline();
      tl.to(panel, { opacity: 1, duration: 0.35, ease: 'power1.out' })
        .from('#panel-ghost',      { opacity: 0, scale: 1.04, duration: 1.4, ease: 'power2.out' }, 0.05)
        .from('#panel-nav',        { opacity: 0, y: -6, duration: 0.3 }, 0.12)
        .from('#pd-domain',        { opacity: 0, y: 14, duration: 0.35 }, 0.22)
        .from('#pd-company',       { opacity: 0, y: 28, duration: 0.55, ease: 'power3.out' }, 0.30)
        .from('#pd-role',          { opacity: 0, y: 14, duration: 0.4 },  0.44)
        .from('#pd-period',        { opacity: 0, y: 8,  duration: 0.3 },  0.54)
        .from('.pd-divider',       { scaleX: 0, duration: 0.4, transformOrigin: 'left' }, 0.58)
        .from('#pd-narrative',     { opacity: 0, y: 8,  duration: 0.45 }, 0.64)
        .from('.stat',             { opacity: 0, y: 18, stagger: 0.07, duration: 0.4 }, 0.36)
        .from('.pd-section-label', { opacity: 0, duration: 0.3 }, 0.32)
        .from('.pd-tools-label',   { opacity: 0, duration: 0.3 }, 0.70)
        .from('.tool-chip',        { opacity: 0, stagger: 0.025, duration: 0.3 }, 0.76);
    }

    function closePanel() {
      if (!panelOpen) return;
      panelOpen = false;
      const panel = document.getElementById('panel');

      gsap.to(panel, {
        opacity: 0, duration: 0.28,
        onComplete: () => {
          panel.style.display = 'none';
          gsap.set(panel, { opacity: 1 });
          panel.setAttribute('aria-hidden', 'true');
          gsap.to(camera.position, {
            x: camHome.x, y: camHome.y, z: camHome.z,
            duration: 1.3, ease: 'power2.inOut',
          });
        },
      });
    }

    document.getElementById('panel-back').addEventListener('click', closePanel);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });

    /* ══════════════════════════════════════
       ANIMATE
    ══════════════════════════════════════ */
    const clock = new THREE.Clock();
    const driftTarget = new THREE.Vector2();
    const driftCurrent = new THREE.Vector2();

    function tick() {
      requestAnimationFrame(tick);
      const t = clock.getElapsedTime();
      starMat.uniforms.uTime.value = t;

      // planet rotation
      meshes.forEach((m, i) => {
        m.rotation.y = t * (0.07 + i * 0.011);
        m.rotation.x = t * 0.025;
      });

      // hover detection
      if (!panelOpen) {
        raycaster.setFromCamera(mouse, camera);
        const hits = raycaster.intersectObjects(meshes);
        const newIdx = hits.length > 0 ? meshes.indexOf(hits[0].object) : -1;

        if (newIdx !== hoveredIdx) {
          if (hoveredIdx >= 0) {
            gsap.to(glows[hoveredIdx].material, { opacity: 0.35, duration: 0.4 });
            labelEls[hoveredIdx].classList.remove('hovered');
          }
          hoveredIdx = newIdx;
          if (hoveredIdx >= 0) {
            gsap.to(glows[hoveredIdx].material, { opacity: 0.88, duration: 0.4 });
            labelEls[hoveredIdx].classList.add('hovered');
            document.body.style.cursor = 'pointer';
          } else {
            document.body.style.cursor = 'crosshair';
          }
        }

        // camera parallax drift
        driftTarget.set(mouse.x * 0.45, mouse.y * 0.28);
        driftCurrent.lerp(driftTarget, 0.028);
        camera.position.x = camHome.x + driftCurrent.x;
        camera.position.y = camHome.y + driftCurrent.y;
        camera.lookAt(0, 0, 0);
      }

      // label projection
      NODES.forEach((node, i) => {
        const v = new THREE.Vector3(...node.pos).project(camera);
        const x = (v.x * 0.5 + 0.5) * innerWidth;
        const y = (-v.y * 0.5 + 0.5) * innerHeight;
        labelEls[i].style.left = x + 'px';
        labelEls[i].style.top  = (y + node.size * 62 + 14) + 'px';
      });

      renderer.render(scene, camera);
    }
    tick();

    /* ══════════════════════════════════════
       LOADER OUT
    ══════════════════════════════════════ */
    gsap.to('#loader-bar', { width: '100%', duration: 1.5, ease: 'power1.inOut', delay: 0.1 });
    gsap.to('#loader', {
      opacity: 0, duration: 0.7, delay: 1.7,
      onComplete: () => { document.getElementById('loader').style.display = 'none'; },
    });

    // fade hint after 5s
    gsap.to('#hint', { opacity: 0, duration: 1.2, delay: 5 });

    /* resize */
    window.addEventListener('resize', () => {
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(innerWidth, innerHeight);
    });
  </script>
</body>
</html>
