---
// Lavanya Joshi — Space Experience Portfolio
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lavanya Joshi</title>
  <meta name="description" content="Lavanya Joshi — Operations, AI, CVD Diamond & Space Technology. Bay Area." />
  <meta property="og:title" content="Lavanya Joshi" />
  <meta property="og:description" content="Operations, AI, CVD Diamond & Space Technology. Bay Area." />
  <meta property="og:url" content="https://lavj1462.github.io" />
  <link rel="canonical" href="https://lavj1462.github.io" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --mono: 'Space Mono', 'Courier New', monospace;
      --serif: 'Cormorant Garamond', Georgia, serif;
      --bg: #03040D;
      --ink: #ECE8DF;
      --ink-mid: rgba(236,232,223,0.55);
      --ink-mute: rgba(236,232,223,0.32);
      --ink-faint: rgba(236,232,223,0.09);
      --accent: #5CE8D4;
    }

    html, body {
      width: 100%; height: 100%;
      overflow: hidden;
      background: var(--bg);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      cursor: crosshair;
    }

    canvas#space {
      position: fixed;
      inset: 0;
      display: block;
      z-index: 0;
    }

    /* ══════════════════════════════════════
       LOADER
    ══════════════════════════════════════ */
    #loader {
      position: fixed; inset: 0;
      background: var(--bg);
      z-index: 500;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0;
    }
    #loader-eye {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--ink-mute);
      margin-bottom: 22px;
    }
    #loader-title {
      font-family: var(--serif);
      font-weight: 300;
      font-size: clamp(52px, 9vw, 112px);
      line-height: 1.0;
      text-align: center;
      color: var(--ink);
      letter-spacing: -0.01em;
    }
    #loader-title em {
      font-style: italic;
      color: var(--accent);
    }
    #loader-bar-wrap {
      margin-top: 44px;
      width: 180px;
      height: 1px;
      background: var(--ink-faint);
    }
    #loader-bar {
      height: 100%;
      width: 0%;
      background: var(--accent);
    }

    /* ══════════════════════════════════════
       UI OVERLAY
    ══════════════════════════════════════ */
    #ui {
      position: fixed; inset: 0;
      z-index: 20;
      pointer-events: none;
    }
    #ui-top {
      padding: 28px 40px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    .ui-name {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.24em;
      color: var(--ink-mid);
    }
    .ui-tagline {
      font-family: var(--mono);
      font-size: 8px;
      letter-spacing: 0.16em;
      color: var(--ink-mute);
      text-align: right;
      line-height: 1.7;
    }
    #labels {
      position: absolute; inset: 0;
      pointer-events: none;
    }
    .nlabel {
      position: absolute;
      transform: translate(-50%, 0);
      text-align: center;
      pointer-events: none;
    }
    .nlabel__name {
      display: block;
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.22em;
      color: rgba(236,232,223,0.55);
      white-space: nowrap;
      transition: color 0.3s;
    }
    .nlabel__sub {
      display: block;
      font-family: var(--mono);
      font-size: 7px;
      letter-spacing: 0.12em;
      color: rgba(236,232,223,0.22);
      margin-top: 4px;
      white-space: nowrap;
      transition: color 0.3s;
    }
    .nlabel.hovered .nlabel__name { color: rgba(236,232,223,0.95); }
    .nlabel.hovered .nlabel__sub  { color: rgba(236,232,223,0.55); }

    #hint {
      position: absolute;
      bottom: 36px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.28em;
      color: var(--ink-mute);
      white-space: nowrap;
      animation: breathe 4s ease-in-out infinite;
    }
    @keyframes breathe {
      0%,100% { opacity: 0.6; }
      50%      { opacity: 1; }
    }

    /* ══════════════════════════════════════
       DETAIL PANEL — full screen editorial
    ══════════════════════════════════════ */
    #panel {
      position: fixed; inset: 0;
      z-index: 200;
      background: rgba(3, 4, 13, 0.97);
      display: none;
      flex-direction: column;
      pointer-events: all;
      /* accent color updated per-planet via JS */
      --accent: #5CE8D4;
    }

    /* giant ghosted company name in background */
    #panel-ghost {
      position: absolute;
      left: 50%;
      top: 48%;
      transform: translate(-50%, -50%);
      font-family: var(--serif);
      font-weight: 300;
      font-size: clamp(72px, 16vw, 240px);
      white-space: nowrap;
      letter-spacing: -0.02em;
      color: var(--accent);
      opacity: 0.05;
      pointer-events: none;
      user-select: none;
      line-height: 1;
    }

    /* top nav bar */
    #panel-nav {
      position: relative;
      z-index: 2;
      height: 58px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 52px;
      border-bottom: 1px solid var(--ink-faint);
    }
    #panel-back {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.22em;
      color: var(--ink-mute);
      background: none;
      border: none;
      cursor: pointer;
      transition: color 0.2s;
      padding: 0;
    }
    #panel-back:hover { color: var(--accent); }
    #panel-no {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.2em;
      color: var(--accent);
      opacity: 0.7;
    }

    /* two-column body */
    #panel-body {
      position: relative;
      z-index: 2;
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      overflow: hidden;
    }

    /* ── LEFT: identity + narrative ── */
    #panel-left {
      padding: 56px 60px;
      border-right: 1px solid var(--ink-faint);
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow-y: auto;
    }

    .pd-domain {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.24em;
      color: var(--accent);
      margin-bottom: 22px;
    }
    .pd-company {
      font-family: var(--serif);
      font-weight: 300;
      font-size: clamp(38px, 5.5vw, 76px);
      line-height: 1.03;
      letter-spacing: -0.01em;
      color: var(--ink);
      margin-bottom: 14px;
    }
    .pd-role {
      font-family: var(--serif);
      font-weight: 300;
      font-style: italic;
      font-size: clamp(16px, 1.8vw, 22px);
      color: var(--ink-mid);
      margin-bottom: 10px;
    }
    .pd-period {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.16em;
      color: var(--ink-mute);
      margin-bottom: 44px;
    }

    .pd-divider {
      width: 40px;
      height: 1px;
      background: var(--accent);
      opacity: 0.4;
      margin-bottom: 30px;
    }

    .pd-narrative {
      font-family: var(--serif);
      font-weight: 300;
      font-size: clamp(15px, 1.4vw, 19px);
      line-height: 1.82;
      color: var(--ink-mid);
      max-width: 54ch;
    }

    /* ── RIGHT: stats + tools ── */
    #panel-right {
      padding: 56px 60px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow-y: auto;
    }

    .pd-section-label {
      font-family: var(--mono);
      font-size: 8px;
      letter-spacing: 0.28em;
      color: var(--ink-mute);
      margin-bottom: 30px;
    }

    /* 2×2 stats grid */
    #pd-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      margin-bottom: 56px;
    }
    .stat {
      border-top: 1px solid var(--accent);
      padding: 18px 24px 18px 0;
    }
    .stat:nth-child(even) {
      padding-left: 24px;
      padding-right: 0;
      border-left: 1px solid var(--ink-faint);
    }
    .stat__val {
      display: block;
      font-family: var(--mono);
      font-size: clamp(28px, 4vw, 52px);
      font-weight: 700;
      color: var(--ink);
      line-height: 1;
      margin-bottom: 10px;
      letter-spacing: -0.02em;
    }
    .stat__lbl {
      display: block;
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.1em;
      color: var(--ink-mute);
      line-height: 1.5;
    }

    /* tools */
    .pd-tools-label {
      font-family: var(--mono);
      font-size: 8px;
      letter-spacing: 0.28em;
      color: var(--ink-mute);
      margin-bottom: 16px;
    }
    #pd-tools {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }
    .tool-chip {
      font-family: var(--mono);
      font-size: 8px;
      letter-spacing: 0.1em;
      color: var(--ink-mute);
      border: 1px solid var(--ink-faint);
      padding: 5px 11px;
      transition: border-color 0.2s, color 0.2s;
    }
    .tool-chip:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* ══════════════════════════════════════
       RESPONSIVE — stack on small screens
    ══════════════════════════════════════ */
    @media (max-width: 800px) {
      #panel-body {
        grid-template-columns: 1fr;
        overflow-y: auto;
      }
      #panel-left {
        border-right: none;
        border-bottom: 1px solid var(--ink-faint);
        padding: 40px 28px;
      }
      #panel-right { padding: 40px 28px; }
      #panel-nav { padding: 0 28px; }
    }
  </style>
</head>
<body>
  <canvas id="space"></canvas>

  <!-- ── Loader ── -->
  <div id="loader">
    <p id="loader-eye">Lavanya Joshi</p>
    <h1 id="loader-title">Entering<br /><em>orbit</em></h1>
    <div id="loader-bar-wrap"><div id="loader-bar"></div></div>
  </div>

  <!-- ── UI ── -->
  <div id="ui">
    <div id="ui-top">
      <span class="ui-name">LAVANYA JOSHI</span>
      <span class="ui-tagline">PRODUCTION · AI · CVD DIAMOND<br />ROBOTICS · SPACE TECHNOLOGY</span>
    </div>
    <div id="labels"></div>
    <div id="hint">SELECT A NODE</div>
  </div>

  <!-- ── Detail Panel ── -->
  <div id="panel" aria-hidden="true" role="dialog">
    <div id="panel-ghost"></div>

    <div id="panel-nav">
      <button id="panel-back">← BACK TO ORBIT</button>
      <span id="panel-no"></span>
    </div>

    <div id="panel-body">
      <div id="panel-left">
        <div class="pd-domain" id="pd-domain"></div>
        <div class="pd-company" id="pd-company"></div>
        <div class="pd-role" id="pd-role"></div>
        <div class="pd-period" id="pd-period"></div>
        <div class="pd-divider"></div>
        <p class="pd-narrative" id="pd-narrative"></p>
      </div>

      <div id="panel-right">
        <div class="pd-section-label">MISSION STATS</div>
        <div id="pd-stats"></div>
        <div class="pd-tools-label">TOOLS &amp; SYSTEMS</div>
        <div id="pd-tools"></div>
      </div>
    </div>
  </div>

  <script>
    import * as THREE from 'three';
    import { gsap } from 'gsap';

    /* ══════════════════════════════════════
       NODE DATA
    ══════════════════════════════════════ */
    const NODES = [
      {
        id: 'sp3',
