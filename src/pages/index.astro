            ],
          },
        ],
        tags: ['Mission Ops', 'Technical Operations', 'Systems Thinking', 'Lean Six Sigma', 'ITAR/EAR', 'Program Management'],
      },
      {
        id: 'about',
        label: 'About',
        sub: 'Bay Area · Open to work',
        pos: [-3.0, -2.5, 0.2],
        hex: 0xF8F0E0,
        rgb: [248, 240, 224],
        size: 0.6,
        cat: 'About',
        title: 'Lavanya Joshi',
        roles: [
          {
            co: 'Background',
            title: 'Bay Area, CA · Open to opportunities',
            bullets: [
              'B.S. Management Information Systems — San Jose State University (GPA 4.0, Dec 2025)',
              '6 languages: English, Hindi, Kannada, Tamil, Telugu, Spanish',
