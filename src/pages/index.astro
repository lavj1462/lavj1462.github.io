            ],
          },
        ],
        tags: [],
        isAbout: true,
      },
    ];

    // ─── Scene setup ────────────────────────────────────────────
    const canvas  = document.getElementById('space');
    const scene   = new THREE.Scene();
    const camera  = new THREE.PerspectiveCamera(58, innerWidth / innerHeight, 0.1, 1000);
    camera.position.set(0, 0, 13);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setSize(innerWidth, innerHeight);
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    // Lights
    scene.add(new THREE.AmbientLight(0xffffff, 0.4));
    const sun = new THREE.DirectionalLight(0xffffff, 1.2);
    sun.position.set(5, 8, 6);
    scene.add(sun);

    // ─── Starfield with twinkling shader ────────────────────────
    const starCount = 9000;
    const starGeo = new THREE.BufferGeometry();
    const starPos  = new Float32Array(starCount * 3);
    const starSize = new Float32Array(starCount);
    const starPhase= new Float32Array(starCount);

    for (let i = 0; i < starCount; i++) {
      const r = 80 + Math.random() * 220;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      starPos[i*3]   = r * Math.sin(phi) * Math.cos(theta);
      starPos[i*3+1] = r * Math.sin(phi) * Math.sin(theta);
      starPos[i*3+2] = r * Math.cos(phi);
      starSize[i]  = 0.5 + Math.random() * 2.5;
      starPhase[i] = Math.random() * Math.PI * 2;
    }
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
    starGeo.setAttribute('aSize',    new THREE.BufferAttribute(starSize, 1));
    starGeo.setAttribute('aPhase',   new THREE.BufferAttribute(starPhase, 1));

    const starMat = new THREE.ShaderMaterial({
      uniforms: { uTime: { value: 0 } },
      vertexShader: `
        attribute float aSize;
        attribute float aPhase;
        uniform float uTime;
        void main() {
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          float twinkle = 0.7 + 0.3 * sin(uTime * 1.8 + aPhase);
          gl_PointSize = aSize * twinkle * (300.0 / -gl_Position.z);
        }
      `,
      fragmentShader: `
        void main() {
          float d = length(gl_PointCoord - vec2(0.5));
          if (d > 0.5) discard;
          float a = smoothstep(0.5, 0.1, d);
          gl_FragColor = vec4(1.0, 1.0, 1.0, a * 0.85);
        }
      `,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });
    scene.add(new THREE.Points(starGeo, starMat));

    // ─── Nebula (large background sprites) ──────────────────────
    function makeNebulaTexture(r, g, b) {
      const c = document.createElement('canvas');
      c.width = c.height = 512;
      const cx = c.getContext('2d');
      const grad = cx.createRadialGradient(256, 256, 0, 256, 256, 256);
      grad.addColorStop(0,   `rgba(${r},${g},${b},0.18)`);
      grad.addColorStop(0.5, `rgba(${r},${g},${b},0.05)`);
      grad.addColorStop(1,   `rgba(0,0,0,0)`);
      cx.fillStyle = grad;
      cx.fillRect(0, 0, 512, 512);
      return new THREE.CanvasTexture(c);
    }
    const nebulaDefs = [
      { pos: [-6,  3, -8], size: 22, tex: makeNebulaTexture(80, 40, 180) },
      { pos: [ 8, -2, -10], size: 18, tex: makeNebulaTexture(20, 80, 160) },
      { pos: [ 0,  6, -12], size: 20, tex: makeNebulaTexture(160, 40, 80) },
      { pos: [-4, -5, -9], size: 16, tex: makeNebulaTexture(40, 160, 140) },
    ];
    nebulaDefs.forEach(d => {
      const sp = new THREE.Sprite(new THREE.SpriteMaterial({
        map: d.tex, transparent: true, depthWrite: false,
        blending: THREE.AdditiveBlending, opacity: 0.9,
      }));
      sp.position.set(...d.pos);
      sp.scale.set(d.size, d.size, 1);
      scene.add(sp);
    });

    // ─── Glow texture ────────────────────────────────────────────
    function makeGlowTex(r, g, b) {
      const c = document.createElement('canvas');
      c.width = c.height = 256;
      const cx = c.getContext('2d');
      const grad = cx.createRadialGradient(128,128,0, 128,128,128);
      grad.addColorStop(0,   `rgba(${r},${g},${b},0.6)`);
      grad.addColorStop(0.3, `rgba(${r},${g},${b},0.2)`);
      grad.addColorStop(1,   `rgba(0,0,0,0)`);
      cx.fillStyle = grad;
      cx.fillRect(0, 0, 256, 256);
      return new THREE.CanvasTexture(c);
    }

    // ─── Build planet nodes ───────────────────────────────────────
    const meshes = [];
    const labelEls = [];
    const labelsContainer = document.getElementById('labels');

    NODES.forEach((nd, i) => {
      // Sphere
      const geo = new THREE.SphereGeometry(nd.size, 40, 40);
      const mat = new THREE.MeshStandardMaterial({
        color: nd.hex,
        emissive: nd.hex,
        emissiveIntensity: 0.15,
        roughness: 0.65,
        metalness: 0.25,
      });
      const mesh = new THREE.Mesh(geo, mat);
      mesh.position.set(...nd.pos);
      mesh.userData.nodeIndex = i;
      scene.add(mesh);
      meshes.push(mesh);

      // Glow sprite
      const glowSp = new THREE.Sprite(new THREE.SpriteMaterial({
        map: makeGlowTex(...nd.rgb),
        transparent: true, depthWrite: false,
        blending: THREE.AdditiveBlending, opacity: 0.7,
      }));
      const gs = nd.size * 3.5;
      glowSp.scale.set(gs, gs, 1);
      glowSp.position.set(...nd.pos);
      scene.add(glowSp);
      nd._glow = glowSp;
      nd._mesh = mesh;

      // Point light
      const pl = new THREE.PointLight(nd.hex, 0.6, 12);
      pl.position.set(...nd.pos);
      scene.add(pl);
      nd._light = pl;

      // HTML label
      const el = document.createElement('div');
      el.className = 'nlabel';
      el.innerHTML = `<span class="nlabel__name">${nd.label}</span><span class="nlabel__sub">${nd.sub}</span>`;
      labelsContainer.appendChild(el);
      labelEls.push(el);
      nd._label = el;
    });

    // ─── Interaction ──────────────────────────────────────────────
    const raycaster = new THREE.Raycaster();
    raycaster.params.Points.threshold = 0.1;
    const mouse = new THREE.Vector2();
    let hoveredIdx = -1;
    let activeIdx  = -1;
    let panelOpen  = false;

    // Camera drift state
    let targetCamX = 0, targetCamY = 0;
    let currentCamX = 0, currentCamY = 0;
    let zoomedPos = null; // when zoomed in, camera target

    window.addEventListener('mousemove', e => {
      mouse.x = (e.clientX / innerWidth)  * 2 - 1;
      mouse.y = -(e.clientY / innerHeight) * 2 + 1;
      targetCamX = (e.clientX / innerWidth  - 0.5) *  2.0;
      targetCamY = (e.clientY / innerHeight - 0.5) * -1.2;
    });

    // Panel close
    document.getElementById('panel-close').addEventListener('click', closePanel);
    document.getElementById('panel').addEventListener('click', e => {
      if (e.target === document.getElementById('panel')) closePanel();
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });

    function openPanel(idx) {
      activeIdx = idx;
      panelOpen = true;
      const nd = NODES[idx];
      document.getElementById('hint').classList.add('hidden');

      // Render content
      const body = document.getElementById('panel-body');
      const color = `rgb(${nd.rgb[0]},${nd.rgb[1]},${nd.rgb[2]})`;
      let html = `
        <div class="p-cat" style="color:${color}">${nd.cat}</div>
        <div class="p-title">${nd.title.replace('\n','<br>')}</div>
      `;
      nd.roles.forEach(r => {
        html += `
          <div class="p-role">
            <div class="p-role__co">${r.co}</div>
            <div class="p-role__title">${r.title}</div>
            <ul>${r.bullets.map(b => `<li>${b}</li>`).join('')}</ul>
          </div>
        `;
      });
      if (nd.isAbout) {
        html += `
          <div style="margin-top:28px; display:flex; flex-direction:column; gap:0;">
            <a class="p-contact-link" href="mailto:lavanya.joshi40@gmail.com">lavanya.joshi40@gmail.com</a>
            <a class="p-contact-link" href="https://linkedin.com/in/lavanya-joshi" target="_blank" rel="noopener">linkedin.com/in/lavanya-joshi</a>
            <a class="p-contact-link" href="https://github.com/lavj1462" target="_blank" rel="noopener">github.com/lavj1462</a>
            <a class="p-contact-link" href="https://lavj1462.github.io">lavj1462.github.io</a>
          </div>
        `;
      }
      if (nd.tags.length) {
        html += `<div class="p-tags">${nd.tags.map(t => `<span class="p-tag">${t}</span>`).join('')}</div>`;
      }
      body.innerHTML = html;
      document.getElementById('panel-scroll').scrollTop = 0;
      document.getElementById('panel').classList.add('open');

      // Zoom camera toward the planet
      const target = new THREE.Vector3(...nd.pos);
      zoomedPos = { x: target.x * 0.28, y: target.y * 0.18, z: 9 };
      gsap.to(camera.position, { ...zoomedPos, duration: 1.1, ease: 'power3.inOut' });

      // Pulse the planet glow
      gsap.to(nd._mesh.material, { emissiveIntensity: 0.55, duration: 0.5 });
      gsap.to(nd._glow, { opacity: 1, duration: 0.5 });
    }

    function closePanel() {
      if (!panelOpen) return;
      panelOpen = false;
      document.getElementById('panel').classList.remove('open');
      document.getElementById('hint').classList.remove('hidden');
      const nd = NODES[activeIdx];
      gsap.to(nd._mesh.material, { emissiveIntensity: 0.15, duration: 0.5 });
      gsap.to(nd._glow, { opacity: 0.7, duration: 0.5 });
      gsap.to(camera.position, { x: 0, y: 0, z: 13, duration: 1.1, ease: 'power3.inOut' });
      zoomedPos = null;
      activeIdx = -1;
    }

    canvas.addEventListener('click', () => {
      if (hoveredIdx >= 0 && hoveredIdx !== activeIdx) {
        openPanel(hoveredIdx);
      }
    });

    // ─── Animate ──────────────────────────────────────────────────
    const clock = new THREE.Clock();
    const projVec = new THREE.Vector3();

    function animate() {
      requestAnimationFrame(animate);
      const t = clock.getElapsedTime();
      starMat.uniforms.uTime.value = t;

      // Planet float + rotate
      NODES.forEach((nd, i) => {
        nd._mesh.position.y = nd.pos[1] + Math.sin(t * 0.45 + i * 1.3) * 0.14;
        nd._mesh.rotation.y += 0.003 + i * 0.0005;
        nd._glow.position.y = nd._mesh.position.y;
      });

      // Camera drift (only when not zoomed)
      if (!panelOpen) {
        currentCamX += (targetCamX - currentCamX) * 0.04;
        currentCamY += (targetCamY - currentCamY) * 0.04;
        camera.position.x += (currentCamX - camera.position.x) * 0.08;
        camera.position.y += (currentCamY - camera.position.y) * 0.08;
        camera.position.z += (13 - camera.position.z) * 0.04;
      }
      camera.lookAt(0, 0, 0);

      // Raycasting for hover
      raycaster.setFromCamera(mouse, camera);
      const hits = raycaster.intersectObjects(meshes);
      const newHovered = hits.length > 0 ? hits[0].object.userData.nodeIndex : -1;

      if (newHovered !== hoveredIdx) {
        // Un-hover old
        if (hoveredIdx >= 0 && hoveredIdx !== activeIdx) {
          gsap.to(NODES[hoveredIdx]._mesh.material, { emissiveIntensity: 0.15, duration: 0.3 });
          gsap.to(NODES[hoveredIdx]._glow, { opacity: 0.7, duration: 0.3 });
          NODES[hoveredIdx]._label.classList.remove('hovered');
        }
        hoveredIdx = newHovered;
        // Hover new
        if (hoveredIdx >= 0 && hoveredIdx !== activeIdx) {
          gsap.to(NODES[hoveredIdx]._mesh.material, { emissiveIntensity: 0.45, duration: 0.3 });
          gsap.to(NODES[hoveredIdx]._glow, { opacity: 1, duration: 0.3 });
          NODES[hoveredIdx]._label.classList.add('hovered');
        }
        canvas.style.cursor = hoveredIdx >= 0 ? 'pointer' : 'default';
      }

      // Update label positions
      NODES.forEach((nd, i) => {
        projVec.set(...nd.pos);
        projVec.y = nd._mesh.position.y - nd.size - 0.45;
        projVec.project(camera);
        const sx = ( projVec.x * 0.5 + 0.5) * innerWidth;
        const sy = (-projVec.y * 0.5 + 0.5) * innerHeight;
        nd._label.style.left = sx + 'px';
        nd._label.style.top  = sy + 'px';
        nd._label.style.opacity = projVec.z < 1 ? '1' : '0';
      });

      renderer.render(scene, camera);
    }
    animate();

    // ─── Resize ────────────────────────────────────────────────
    window.addEventListener('resize', () => {
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(innerWidth, innerHeight);
    });

    // ─── Loading sequence ──────────────────────────────────────
    const loaderBar = document.getElementById('loader-bar');
    const loader = document.getElementById('loader');
    setTimeout(() => { loaderBar.style.width = '100%'; }, 80);
    setTimeout(() => {
      loader.classList.add('out');
      setTimeout(() => loader.remove(), 1000);
    }, 1600);
  </script>

</body>
</html>
