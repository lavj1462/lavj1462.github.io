---
// Lavanya Joshi — Space Experience Portfolio
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lavanya Joshi</title>
  <meta name="description" content="Lavanya Joshi — Operations, AI, CVD Diamond & Space Technology. Bay Area." />
  <meta property="og:title" content="Lavanya Joshi" />
  <meta property="og:description" content="Operations, AI, CVD Diamond & Space Technology. Bay Area." />
  <meta property="og:url" content="https://lavj1462.github.io" />
  <link rel="canonical" href="https://lavj1462.github.io" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 100%; height: 100%;
      overflow: hidden;
      background: #02020A;
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      color: #fff;
    }

    canvas#space {
      position: fixed;
      inset: 0;
      display: block;
    }

    /* ── Loading screen ── */
    #loader {
      position: fixed; inset: 0;
      background: #02020A;
      z-index: 200;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      transition: opacity 1s ease;
    }
    #loader.out { opacity: 0; pointer-events: none; }
    #loader-name {
      font-size: 13px;
      font-weight: 200;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.5);
    }
    #loader-bar-wrap {
      width: 140px;
      height: 1px;
      background: rgba(255,255,255,0.08);
      overflow: hidden;
    }
    #loader-bar {
      height: 100%;
      width: 0%;
      background: rgba(255,255,255,0.5);
      transition: width 1.4s cubic-bezier(0.4,0,0.2,1);
    }
    #loader-hint {
      font-size: 10px;
      font-weight: 300;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.2);
    }

    /* ── UI overlay ── */
    #ui {
      position: fixed; inset: 0;
      pointer-events: none;
      z-index: 20;
    }

    /* top bar */
    #top {
      position: absolute;
      top: 0; left: 0; right: 0;
      padding: 28px 40px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    #top-name {
      font-size: 13px;
      font-weight: 300;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
    }
    #top-sub {
      font-size: 10px;
      font-weight: 300;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.3);
      margin-top: 5px;
    }
    #top-links {
      display: flex;
      gap: 24px;
      pointer-events: all;
    }
    #top-links a {
      font-size: 10px;
      font-weight: 300;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.35);
      text-decoration: none;
      transition: color 200ms;
    }
    #top-links a:hover { color: rgba(255,255,255,0.85); }

    /* bottom hint */
    #hint {
      position: absolute;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 10px;
      font-weight: 300;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.25);
      white-space: nowrap;
      animation: breathe 3s ease-in-out infinite;
      transition: opacity 0.5s;
    }
    #hint.hidden { opacity: 0; }
    @keyframes breathe {
      0%,100% { opacity: 0.25; }
      50%      { opacity: 0.55; }
    }

    /* node labels */
    .nlabel {
      position: absolute;
      transform: translate(-50%, 0);
      text-align: center;
      pointer-events: none;
      transition: opacity 0.3s;
    }
    .nlabel__name {
      display: block;
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.65);
      white-space: nowrap;
    }
    .nlabel__sub {
      display: block;
      font-size: 9px;
      font-weight: 300;
      letter-spacing: 0.1em;
      color: rgba(255,255,255,0.28);
      margin-top: 3px;
      white-space: nowrap;
    }
    .nlabel.hovered .nlabel__name { color: rgba(255,255,255,0.95); }
    .nlabel.hovered .nlabel__sub  { color: rgba(255,255,255,0.55); }

    /* ── Content Panel ── */
    #panel {
      position: fixed;
      top: 0; right: 0;
      width: min(500px, 100vw);
      height: 100%;
      background: rgba(3, 3, 16, 0.94);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-left: 1px solid rgba(255,255,255,0.06);
      z-index: 100;
      transform: translateX(100%);
      transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
      overflow-y: auto;
      pointer-events: all;
    }
    #panel.open { transform: translateX(0); }

    #panel-scroll {
      padding: 40px 40px 60px;
    }

    #panel-close {
      position: sticky;
      top: 20px;
      float: right;
      clear: right;
      width: 30px; height: 30px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 50%;
      color: rgba(255,255,255,0.5);
      font-size: 18px;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 200ms, color 200ms;
      margin-bottom: 28px;
      line-height: 1;
    }
    #panel-close:hover { background: rgba(255,255,255,0.12); color: #fff; }

    .p-cat {
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .p-title {
      font-size: 26px;
      font-weight: 200;
      line-height: 1.22;
      color: rgba(255,255,255,0.92);
      margin-bottom: 36px;
      letter-spacing: -0.01em;
    }

    .p-role {
      margin-bottom: 24px;
      padding-bottom: 24px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .p-role:last-of-type { border-bottom: none; }
    .p-role__co {
      font-size: 13px;
      font-weight: 400;
      color: rgba(255,255,255,0.88);
      margin-bottom: 3px;
    }
    .p-role__title {
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 0.05em;
      color: rgba(255,255,255,0.38);
      margin-bottom: 12px;
    }
    .p-role ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .p-role li {
      font-size: 12px;
      font-weight: 300;
      color: rgba(255,255,255,0.55);
      padding-left: 16px;
      position: relative;
      line-height: 1.55;
    }
    .p-role li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: rgba(255,255,255,0.18);
    }

    .p-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 28px;
    }
    .p-tag {
      font-size: 9px;
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.35);
      border: 1px solid rgba(255,255,255,0.1);
      padding: 5px 10px;
    }

    .p-contact-link {
      display: block;
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 0.05em;
      color: rgba(255,255,255,0.5);
      text-decoration: none;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      transition: color 200ms;
    }
    .p-contact-link:hover { color: rgba(255,255,255,0.9); }

    /* mobile adjustments */
    @media (max-width: 600px) {
      #top { padding: 20px 20px; }
      #top-links { display: none; }
      #panel-scroll { padding: 32px 24px 48px; }
      .p-title { font-size: 22px; }
    }
  </style>
</head>
