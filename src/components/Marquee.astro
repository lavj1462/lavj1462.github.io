---
// Duplicated for seamless CSS marquee loop
const items = [
  { text: 'AI & ML Ops',           serif: true },
  { text: '×',                     serif: false },
  { text: 'CVD Diamond Production',serif: true },
  { text: '×',                     serif: false },
  { text: 'Robotics Deployment',   serif: true },
  { text: '×',                     serif: false },
  { text: 'Space Technology',      serif: true },
  { text: '×',                     serif: false },
  { text: 'Data & Automation',     serif: true },
  { text: '×',                     serif: false },
  { text: 'Process Design',        serif: true },
  { text: '×',                     serif: false },
  { text: 'Production Operations', serif: true },
  { text: '×',                     serif: false },
];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {items.map(item => (
      item.serif
        ? <span><em>{item.text}</em></span>
        : <span>{item.text}</span>
    ))}
    {/* Duplicate for seamless loop */}
    {items.map(item => (
      item.serif
        ? <span><em>{item.text}</em></span>
        : <span>{item.text}</span>
    ))}
  </div>
</div>
