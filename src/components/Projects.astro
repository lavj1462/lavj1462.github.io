---
const projects = [
  {
    no: '01',
    title: 'ML Data Collection',
    titleEm: 'Strategy Dashboard',
    plateLabel: 'DASHBOARD UI',
    description: 'Designed annotation workflows, QA metrics, and a dashboard tracking dataset health for a robotics use case. Tracks throughput, quality score, and task completion rate to simulate real-world ML data operations monitoring.',
    tags: ['DASHBOARD', 'ML OPS', 'TABLEAU'],
  },
  {
    no: '02',
    title: 'Operations Coordination',
    titleEm: 'Platform',
    plateLabel: 'OPS PLATFORM',
    description: 'Identified inconsistent operator scheduling as a recurring problem and designed a web-based platform to fix it. Defined the full feature set: machine assignments, real-time operator attendance, task assignment, and automatic schedule adjustment based on who\'s present.',
    tags: ['OPS', 'SCHEDULING', 'WEB APP'],
  },
  {
    no: '03',
    title: 'Robot Localization',
    titleEm: 'Particle Filter',
    plateLabel: 'ROBOTICS · ML',
    description: 'Implemented robot localization using a particle filter in Python and OpenCV. The robot estimates its position on a terrain map using 3,000 particles across a motion model (noisy forward/turn movements), a sensor model (terrain elevation readings), and iterative resampling with noise injection to converge on the true location.',
    tags: ['PYTHON', 'PARTICLE FILTER', 'OPENCV', 'ROBOTICS'],
    href: 'https://github.com/lavj1462/robot-localization-particle-filter',
    colabUrl: 'https://colab.research.google.com/github/lavj1462/robot-localization-particle-filter/blob/main/localization.ipynb',
  },
  {
    no: '04',
    title: 'Robovision',
    titleEm: 'BigQuery Analytics',
    plateLabel: 'CLOUD · DATA',
    description: 'Explored a 1.75M-row IoT/robotics sensor dataset end-to-end using Google BigQuery and Looker Studio. Loaded raw sensor logs, built a cleaned view (robovision.nicla_clean), wrote SQL for row counts, label distribution, and sensor summaries, then shipped a one-page Looker Studio dashboard — raw data through to visual in one pipeline.',
    tags: ['BIGQUERY', 'SQL', 'LOOKER STUDIO', 'IOT', 'CLOUD'],
    href: 'https://github.com/lavj1462/Robovision-BigQuery',
  },
];
---

<section id="projects" class="chapter">
  <header class="chapter__head">
    <span class="chapter__num">05</span>
    <h2 class="chapter__title">Selected<br /><em>Projects</em></h2>
    <p class="chapter__lede">Applied ML ops and AI tooling in the real world.</p>
  </header>

  <div class="reveal" style="display: flex; gap: var(--s-6); flex-wrap: wrap;">
    {projects.map(project => (
      <div
        class="proj"
        data-cursor={project.href ? 'open →' : 'view'}
        style={`flex: 1 1 320px; display: flex; flex-direction: column;${project.href ? ' cursor: pointer;' : ''}`}
        onclick={project.href ? `window.open('${project.href}','_blank')` : undefined}
      >
        <!-- Photocopier plate placeholder -->
        <div class="proj__plate copy-plate" style="--plate-tone: var(--pink);">
          <span class="proj__no">{project.no}</span>
          <span class="proj__plate-label">{project.plateLabel}</span>
        </div>

        <div class="proj__meta" style="display: flex; flex-direction: column; flex: 1; gap: var(--s-3);">
          <h4>
            {project.title} <em>{project.titleEm}</em>
          </h4>
          <p style="flex: 1;">{project.description}</p>
          <div class="proj__tags">
            {project.tags.join(' · ')}
          </div>

          {/* Links row — only rendered when href is present */}
          {project.href && (
            <div style="display: flex; align-items: center; gap: var(--s-3); padding-top: var(--s-3); border-top: 1px dashed var(--ink-faint); flex-wrap: wrap;">
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink); border: 1px solid var(--ink-faint); padding: 4px 10px; text-decoration: none; transition: background 180ms, color 180ms, border-color 180ms;"
                onmouseenter="this.style.background='var(--ink)';this.style.color='var(--paper)'"
                onmouseleave="this.style.background='';this.style.color='var(--ink)'"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                GitHub
              </a>
              {project.colabUrl && (
                <a
                  href={project.colabUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pink); border: 1px solid var(--pink); padding: 4px 10px; text-decoration: none; transition: background 180ms, color 180ms;"
                  onmouseenter="this.style.background='var(--pink)';this.style.color='var(--paper)'"
                  onmouseleave="this.style.background='';this.style.color='var(--pink)'"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm-1.5 17.25V6.75L18 12l-7.5 5.25z"/></svg>
                  Open in Colab
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
