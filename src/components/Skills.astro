---
const groups = [
  {
    name: 'Operations & Strategy',
    skills: ['S&OP & Capacity Planning', 'Financial & Operational Modeling', 'KPI Design', 'Process Improvement (Lean Six Sigma)', 'SOP Development', 'Building Operations from Scratch', 'Procurement & Vendor Management'],
  },
  {
    name: 'Programs & Contracts',
    skills: ['Project Scheduling (MS Project, WBS, Critical Path)', 'Earned Value Basics', 'Risk Tracking', 'Government Contracting & Proposals', 'ITAR/EAR Compliance'],
  },
  {
    name: 'Data & Automation',
    skills: ['SQL', 'Python', 'Power BI', 'Tableau', 'Excel', 'Custom AI Agents', 'Claude', 'Codex', 'ERP (M1, NetSuite)', 'Salesforce', 'ML Data Pipelines & QA'],
  },
  {
    name: 'Leadership & Communication',
    skills: ['Cross-Functional Coordination', 'Translating Engineering Requirements for Operators', 'Training & Cross-Training Teams', 'Executive Demos & Stakeholder Presentations'],
  },
  {
    name: 'Industry Experience',
    skills: ['Robotics Deployment', 'AI/ML Data Operations', 'Advanced Materials Manufacturing', 'Chemical-Vapor Deposition Diamond Production', 'Lab Work'],
  },
  {
    name: 'Languages',
    skills: ['English', 'Hindi', 'Kannada', 'Tamil', 'Telugu', 'Spanish'],
    ghost: true,
  },
];
---

<section id="skills" class="chapter">
  <header class="chapter__head">
    <span class="chapter__num">03</span>
    <h2 class="chapter__title">Skills &<br /><em>Toolset</em></h2>
    <p class="chapter__lede">What I bring to the table — from robots to spreadsheets.</p>
  </header>

  <div class="reveal">
    {groups.map(group => (
      <div class="skills-group">
        <span class="skills-group__name">{group.name}</span>
        <div class="skills-group__tags reveal-stagger">
          {group.skills.map(skill => (
            <span class={`tag${group.ghost ? ' tag--ghost' : ''}`}>{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Certifications row -->
  <div style="border-top: 1.5px solid var(--ink); padding-top: var(--s-5); margin-top: var(--s-6);" class="reveal">
    <span class="kicker" style="display:block; margin-bottom: var(--s-4);">Certifications</span>
    <div class="reveal-stagger" style="display: flex; flex-wrap: wrap; gap: var(--s-3);">
      {[
        'AWS AI/ML Scholar',
        'AWS Certified Cloud Practitioner',
        'Google Data Analytics',
        'Lean Six Sigma',
        'Microsoft Azure Data Fundamentals (DP-900)',
        'Professional Scrum Master I',
      ].map(cert => (
        <span class="tag tag--active">{cert}</span>
      ))}
    </div>
  </div>
</section>
