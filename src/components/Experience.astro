---
const jobs = [
  {
    no: '01',
    company: 'Amazon Robotics',
    role: 'Operations Coordinator',
    period: '09/2025 — Present',
    location: 'San Francisco, CA',
    summary: 'Supporting large-scale robotic deployment operations — scheduling, quality, and real-time problem-solving across multi-team runs.',
    bullets: [
      {
        main: 'Supported deployment operations for the Sparrow robotic picking system, coordinating shift-level schedules across multiple teams and resolving workflow disruptions during extended runs.',
        sub: ['Managed cross-team scheduling across overlapping shift windows', 'Escalated disruptions in real-time to engineering leads with full context'],
      },
      {
        main: 'Partnered with engineering stakeholders to triage issues by operational impact, monitoring throughput, induct success rate, and uptime to keep deployments on schedule.',
        sub: ['Prioritised issues by downstream impact on run continuity', 'Maintained live visibility across multiple systems simultaneously'],
      },
      {
        main: 'Onboarded and trained team members on operational protocols and quality standards, achieving and sustaining 91% performance against target.',
        sub: ['Developed training materials adapted to different operator experience levels', 'Ran follow-up check-ins to maintain standard over time'],
      },
      {
        main: 'Tracked robot thermal performance data and identified a 2-hour continuous-uptime limit caused by thermal equilibrium — restructured run schedules around it to protect throughput across multi-hour operations.',
        sub: ['Surfaced pattern independently across multiple robot units', 'Applied finding to restructure all active run schedules proactively'],
      },
    ],
    project: { label: 'Growth', value: 'Project Technician → Operations Coordinator → Data Program Manager' },
    tools: ['Asana', 'Jira', 'Excel', 'Quip', 'Slack', 'Obsidian', 'SageMaker', 'A21', 'Thermal Data Tracking', 'Operational Scheduling'],
    outcomes: ['91% performance target sustained', 'Employee of the Month', 'Reliability Star', 'Impact & Innovation Badge', 'Team Excellence Badge'],
  },
  {
    no: '02',
    company: 'Google DeepMind',
    role: 'Data Analyst Intern — Apollo Project',
    period: '06/2025 — 09/2025',
    location: 'Mountain View, CA',
    summary: 'Embedded within the Apollo Project — diagnosing pipeline inefficiencies, building real-time reporting, and running enterprise demos end-to-end.',
    bullets: [
      {
        main: 'Diagnosed slipping data collection throughput and quality, tracing the root cause to an unclear engineering-to-data-team handoff — drove a 12% improvement in pipeline efficiency by streamlining that workflow.',
        sub: ['Mapped the full handoff process to isolate where annotator idle time was occurring', 'Proposed and implemented a streamlined check-in protocol between teams'],
      },
      {
        main: 'Built real-time reporting in SQL, Python, and Tableau, surfacing performance gaps that directly shaped targeted training programs for annotators.',
        sub: ['Automated daily metric pulls to reduce manual overhead', 'Delivered weekly performance snapshots to team leads and ML stakeholders'],
      },
      {
        main: 'Ran daily enterprise demos, sustaining 2+ hour successful runs with full run-of-show ownership and contingency planning.',
        sub: ['Coordinated logistics and stakeholder briefings ahead of each session', 'Prepared and executed fallback plans for all critical demo decision points'],
      },
    ],
    project: { label: 'Project', value: 'Apollo — ML Data Pipeline' },
    tools: ['SQL', 'Python', 'Tableau', 'Real-Time Reporting', 'Demo Ops'],
    outcomes: ['+12% pipeline efficiency', 'Highest intern efficiency gain', '2+ hr enterprise demo runs'],
  },
  {
    no: '03',
    company: 'Skild AI',
    role: 'Office Coordinator',
    period: '10/2024 — 06/2025',
    location: 'San Mateo, CA',
    summary: 'Built operational infrastructure from the ground up for a fast-growing robotics startup — logistics, vendor relationships, SOPs, and KPI tracking.',
    bullets: [
      {
        main: 'Managed vendor relationships and end-to-end office logistics — from sourcing and designing new office space to coordinating site visits, transportation, and supply inventory for a growing team.',
        sub: ['Coordinated with 5+ vendors simultaneously across overlapping timelines', 'Reduced supply gaps through proactive inventory monitoring and reorder triggers'],
      },
      {
        main: 'Authored SOPs and standardized labeling protocols; led QA checks across all operational workflows to ensure quality and repeatability.',
        sub: ['Protocols adopted team-wide and referenced across onboarding', 'QA checks reduced labeling inconsistencies across data collection runs'],
      },
      {
        main: 'Tracked KPIs including throughput, latency, and cycle time, surfacing data to inform leadership decisions.',
        sub: ['Built tracking templates reused across reporting cycles', 'Presented KPI summaries in weekly leadership syncs'],
      },
    ],
    project: { label: 'Focus', value: 'Office Infrastructure & Ops Build-Out' },
    tools: ['SOP Authoring', 'KPI Tracking', 'Vendor Management', 'QA Protocols', 'Google Workspace'],
    outcomes: ['SOPs established across all workflows', 'Standardized labeling protocols', 'Office designed & launched'],
  },
];
---

<section id="experience" class="chapter">
  <header class="chapter__head">
    <span class="chapter__num">02</span>
    <h2 class="chapter__title">Work<br /><em>Experience</em></h2>
    <p class="chapter__lede">Three companies. Operations, coordination, and data — from robotics deployments to enterprise demos.</p>
  </header>

  <div class="reveal">
    {jobs.map((job, idx) => (
      <div class="exp-entry">

        {/* ── header ── */}
        <div class="exp-entry__meta">
          <span class="row__no" style="font-size: var(--t-md);">{job.no}</span>
          <div>
            <div class="exp-entry__co">{job.company}</div>
            <span class="exp-entry__role">{job.role}</span>
          </div>
          <span class="exp-entry__date">{job.period} · {job.location}</span>
        </div>

        {/* ── summary ── */}
        <p style="font-size: var(--t-sm); color: var(--ink-mute); font-style: italic; margin: 0 0 var(--s-4); max-width: 72ch; line-height: 1.55;">
          {job.summary}
        </p>

        {/* ── bullets with sub-points ── */}
        <ul style="margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: var(--s-3);">
          {job.bullets.map(b => (
            <li style="font-size: var(--t-base); color: var(--ink-soft); line-height: var(--lh-body);">
              {b.main}
              <ul style="margin: var(--s-2) 0 0; padding-left: 1.1em; display: flex; flex-direction: column; gap: 4px; list-style: '– ';">
                {b.sub.map(s => (
                  <li style="font-size: 12px; color: var(--ink-mute); line-height: 1.5;">{s}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>

        {/* ══ SKILD AI — Office Framework Visual ══ */}
        {idx === 2 && (
          <div style="margin-top: var(--s-6); border: 1px solid var(--ink-faint); padding: var(--s-5);">
            <span style="font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--pink); display: block; margin-bottom: var(--s-4);">
              Office Build-Out Framework — Ground Up
            </span>

            {/* Phase flow */}
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-3); margin-bottom: var(--s-5);">
              {[
                { phase: '01', label: 'Sourcing', items: ['Vendor RFP', 'Budget scoping', 'Contract mgmt'] },
                { phase: '02', label: 'Design', items: ['Floor plan layout', 'Zone mapping', 'Furniture selection'] },
                { phase: '03', label: 'Setup', items: ['Site coordination', 'Transport logistics', 'Inventory build'] },
                { phase: '04', label: 'Operations', items: ['SOP rollout', 'QA checks', 'KPI tracking'] },
              ].map((p, i) => (
                <div style="position: relative;">
                  {/* connector arrow (not on last) */}
                  {i < 3 && (
                    <div style="position: absolute; right: -12px; top: 14px; font-family: var(--f-mono); font-size: 10px; color: var(--ink-faint); z-index: 1;">→</div>
                  )}
                  <div style="border: 1px solid var(--ink); padding: var(--s-3);">
                    <div style="display: flex; align-items: baseline; gap: var(--s-2); margin-bottom: var(--s-2);">
                      <span style="font-family: var(--f-mono); font-size: 9px; color: var(--ink-mute);">{p.phase}</span>
                      <span style="font-family: var(--f-sans); font-size: 12px; font-weight: 700; color: var(--ink);">{p.label}</span>
                    </div>
                    <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 3px;">
                      {p.items.map(item => (
                        <li style="font-family: var(--f-mono); font-size: 10px; color: var(--ink-soft);">· {item}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>

            {/* Floor zone map */}
            <span style="font-family: var(--f-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-mute); display: block; margin-bottom: var(--s-3);">Space Organisation</span>
            <div style="display: grid; grid-template-columns: 1fr 2fr 1fr; grid-template-rows: auto auto; gap: 2px;">
              {[
                { label: 'Meeting\nRooms', bg: 'var(--paper-3)', col: '1', row: '1 / 3' },
                { label: 'Main Work\nFloor', bg: 'var(--paper-2)', col: '2', row: '1 / 3' },
                { label: 'Storage &\nSupply', bg: 'var(--paper-3)', col: '3', row: '1' },
                { label: 'Kitchen &\nBreak', bg: 'var(--paper-3)', col: '3', row: '2' },
              ].map(zone => (
                <div style={`background: ${zone.bg}; border: 1px solid var(--ink-faint); padding: var(--s-3); grid-column: ${zone.col}; grid-row: ${zone.row}; display: flex; align-items: center; justify-content: center;`}>
                  <span style="font-family: var(--f-mono); font-size: 10px; color: var(--ink-soft); text-align: center; white-space: pre-line;">{zone.label}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* ══ DEEPMIND — KPI Tracking Visual ══ */}
        {idx === 1 && (
          <div style="margin-top: var(--s-6); border: 1px solid var(--ink-faint); padding: var(--s-5);">
            <span style="font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--pink); display: block; margin-bottom: var(--s-4);">
              KPI Tracking — What Was Measured & How
            </span>

            {/* KPI metric cards */}
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-3); margin-bottom: var(--s-5);">
              {[
                { kpi: 'Pipeline Throughput', desc: 'Volume of data tasks completed per session', delta: '+12%', trend: '↑' },
                { kpi: 'Annotation Quality', desc: 'Error rate & consistency score per annotator', delta: 'Tracked weekly', trend: '✓' },
                { kpi: 'Handoff Latency', desc: 'Time between engineering delivery & data team pickup', delta: 'Reduced', trend: '↓' },
              ].map(m => (
                <div style="border: 1px solid var(--ink); padding: var(--s-4);">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--s-2);">
                    <span style="font-family: var(--f-sans); font-size: 12px; font-weight: 700; color: var(--ink); max-width: 80%;">{m.kpi}</span>
                    <span style="font-family: var(--f-mono); font-size: 16px; color: var(--pink); line-height: 1;">{m.trend}</span>
                  </div>
                  <p style="font-family: var(--f-mono); font-size: 10px; color: var(--ink-mute); margin: 0 0 var(--s-2); line-height: 1.4;">{m.desc}</p>
                  <span style="font-family: var(--f-mono); font-size: 11px; font-weight: 700; color: var(--pink);">{m.delta}</span>
                </div>
              ))}
            </div>

            {/* Tool pipeline flow */}
            <span style="font-family: var(--f-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-mute); display: block; margin-bottom: var(--s-3);">Reporting Pipeline</span>
            <div style="display: flex; align-items: stretch; gap: 0;">
              {[
                { tool: 'SQL', role: 'Extract & query raw performance data from pipeline logs' },
                { tool: 'Python', role: 'Automate metric pulls, trend analysis & anomaly flags' },
                { tool: 'Tableau', role: 'Visualise team dashboards & surface gaps to leads' },
                { tool: 'Insights', role: 'Inform targeted annotator training programs' },
              ].map((step, i) => (
                <div style="display: flex; align-items: stretch; flex: 1;">
                  <div style={`border: 1px solid var(--ink); border-right: none; padding: var(--s-3); flex: 1; ${i === 3 ? 'border-right: 1px solid var(--ink);' : ''}`}>
                    <span style="font-family: var(--f-sans); font-size: 12px; font-weight: 700; color: var(--ink); display: block; margin-bottom: 4px;">{step.tool}</span>
                    <span style="font-family: var(--f-mono); font-size: 9px; color: var(--ink-mute); line-height: 1.4;">{step.role}</span>
                  </div>
                  {i < 3 && (
                    <div style="display: flex; align-items: center; padding: 0 6px; font-family: var(--f-mono); font-size: 12px; color: var(--pink);">→</div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* ── footer strip ── */}
        <div class="exp-entry__footer-strip" style="
          display: grid;
          grid-template-columns: auto 1fr auto;
          gap: var(--s-5);
          margin-top: var(--s-5);
          padding-top: var(--s-4);
          border-top: 1px dashed var(--ink-faint);
          align-items: start;
        ">
          <div style="min-width: 160px;">
            <span style="font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--pink); display: block; margin-bottom: 5px;">{job.project.label}</span>
            <span style="font-family: var(--f-sans); font-size: 12px; font-weight: 600; color: var(--ink);">{job.project.value}</span>
          </div>
          <div>
            <span style="font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); display: block; margin-bottom: 5px;">Tools Used</span>
            <div style="display: flex; flex-wrap: wrap; gap: var(--s-2);">
              {job.tools.map(t => (
                <span style="font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.06em; color: var(--ink); border: 1px solid var(--ink-faint); padding: 2px 8px;">{t}</span>
              ))}
            </div>
          </div>
          <div style="min-width: 180px; text-align: right;">
            <span style="font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); display: block; margin-bottom: 5px;">Outcomes</span>
            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 3px;">
              {job.outcomes.map(o => (
                <span style="font-family: var(--f-sans); font-size: 11px; font-weight: 600; color: var(--pink);">{o}</span>
              ))}
            </div>
          </div>
        </div>

      </div>
    ))}
  </div>

  <!-- Education -->
  <div class="edu-block reveal">
    <div>
      <span class="chapter__num" style="font-size: var(--t-sm);">04</span>
    </div>
    <div>
      <div class="exp-entry__co">
        San Jose State University
        <em style="font-size: 0.7em; margin-left: 8px;">B.S. MIS</em>
      </div>
      <span class="exp-entry__role">Management Information Systems</span>
      <p style="margin: var(--s-2) 0 0; font-size: var(--t-sm); color: var(--ink-mute); font-family: var(--f-mono);">
        06/2025 · San Jose, CA · GPA 4.0
      </p>
      <p style="margin: var(--s-3) 0 0; color: var(--ink-soft); font-size: var(--t-sm); max-width: 60ch;">
        VP of Women in Business · Team Manager, SJSU Robotics Team · Finance Manager, Dance Team
      </p>
    </div>
  </div>
</section>
