---

<section id="experience" class="chapter">
  <header class="chapter__head">
    <span class="chapter__num">02</span>
    <h2 class="chapter__title">Work<br /><em>Experience</em></h2>
    <p class="chapter__lede">Four companies. Production, operations, coordination, and data — from advanced materials manufacturing to robotics deployments and enterprise demos.</p>
  </header>

  <div class="reveal">
    {jobs.map((job, idx) => (
      <div class="exp-entry">

        {/* ── header ── */}
        <div class="exp-entry__meta">
          <span class="row__no" style="font-size: var(--t-md);">{job.no}</span>
          <div>
            <div class="exp-entry__co">{job.company}</div>
            <span class="exp-entry__role">{job.role}</span>
          </div>
          <span class="exp-entry__date">{job.period} · {job.location}</span>
        </div>

        {/* ── summary ── */}
        <p style="font-size: var(--t-sm); color: var(--ink-mute); font-style: italic; margin: 0 0 var(--s-4); max-width: 72ch; line-height: 1.55;">
          {job.summary}
        </p>

        {/* ── bullets with sub-points ── */}
        <ul style="margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: var(--s-3);">
          {job.bullets.map(b => (
            <li style="font-size: var(--t-base); color: var(--ink-soft); line-height: var(--lh-body);">
              {b.main}
              <ul style="margin: var(--s-2) 0 0; padding-left: 1.1em; display: flex; flex-direction: column; gap: 4px; list-style: '– ';">
                {b.sub.map(s => (
                  <li style="font-size: 12px; color: var(--ink-mute); line-height: 1.5;">{s}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>

        {/* ── tools ── */}
        <div style="margin-top: var(--s-5); display: flex; flex-wrap: wrap; gap: var(--s-2);">
          {job.tools.map(t => (
            <span style="font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.06em; color: var(--ink-mute); border: 1px solid var(--ink-faint); padding: 2px 8px;">{t}</span>
          ))}
        </div>

      </div>
    ))}
  </div>

  <!-- Education -->
  <div class="edu-block reveal">
    <div>
      <span class="chapter__num" style="font-size: var(--t-sm);">05</span>
    </div>
    <div>
      <div class="exp-entry__co">
        San Jose State University
        <em style="font-size: 0.7em; margin-left: 8px;">B.S. MIS</em>
      </div>
      <span class="exp-entry__role">Management Information Systems</span>
      <p style="margin: var(--s-2) 0 0; font-size: var(--t-sm); color: var(--ink-mute); font-family: var(--f-mono);">
        12/2025 · San Jose, CA · GPA 4.0
      </p>
      <div style="display: flex; flex-direction: column; gap: var(--s-4); margin-top: var(--s-4);">
        <div>
          <span style="font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--pink); display: block; margin-bottom: var(--s-2);">Leadership</span>
          <div style="display: flex; flex-wrap: wrap; gap: var(--s-2);">
            {['VP, Women in Business', 'Team Manager, SJSU Robotics', 'Finance Manager, Dance Team'].map(role => (
              <span style="font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.06em; color: var(--ink); border: 1px solid var(--ink-faint); padding: 3px 10px;">{role}</span>
            ))}
          </div>
        </div>
        <div>
          <span style="font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--pink); display: block; margin-bottom: var(--s-2);">Relevant Coursework</span>
          <div style="display: flex; flex-wrap: wrap; gap: var(--s-2);">
            {['IT Project Management', 'Systems Analysis & Design', 'Strategic Management', 'Python & Java', 'Database Management Systems', 'Business Intelligence & Analytics', 'Business Process Management'].map(course => (
