---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lavanya Joshi — Data Ops & Robotics',
  description = 'Lavanya Joshi is an AI & ML Data Operations specialist at Amazon Robotics. Previously Google DeepMind and Skild AI. Based in San Francisco.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Lavanya Joshi" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lavj1462.github.io" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://lavj1462.github.io/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://lavj1462.github.io/og.png" />

    <link rel="canonical" href="https://lavj1462.github.io" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- DS Fonts: Inter + Newsreader + Caveat + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400;1,6..72,600&family=Caveat:wght@400;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <!-- grain class applies paper texture from tokens.css -->
  <body class="grain">
    <slot />

    <!-- Minimal dot cursor (desktop only, self-disables on touch) -->
    <script is:inline>
      (function () {
        if (window.matchMedia("(pointer: coarse)").matches) return;

        const root = document.createElement("div");
        root.className = "lj-cursor";
        root.innerHTML = `<div class="lj-cursor__dot"></div><div class="lj-cursor__label"></div>`;
        document.body.appendChild(root);
        document.documentElement.classList.add("lj-cursor-on");

        const dot   = root.querySelector(".lj-cursor__dot");
        const label = root.querySelector(".lj-cursor__label");

        let mx = innerWidth / 2, my = innerHeight / 2;
        let sx = mx, sy = my;

        window.addEventListener("mousemove", (e) => { mx = e.clientX; my = e.clientY; }, { passive: true });
        window.addEventListener("mouseleave", () => root.classList.add("is-hidden"));
        window.addEventListener("mouseenter", () => root.classList.remove("is-hidden"));
        window.addEventListener("mousedown",  () => root.classList.add("is-down"));
        window.addEventListener("mouseup",    () => root.classList.remove("is-down"));

        function tick() {
          // Snappy lerp — 0.22 feels immediate without being jittery
          sx += (mx - sx) * 0.22;
          sy += (my - sy) * 0.22;
          dot.style.transform   = `translate3d(${sx}px,${sy}px,0) translate(-50%,-50%)`;
          label.style.transform = `translate3d(${sx}px,${sy}px,0) translate(16px,12px)`;
          requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);

        function bind() {
          document.querySelectorAll("[data-cursor]").forEach((el) => {
            if (el.__ljBound) return;
            el.__ljBound = true;
            el.addEventListener("mouseenter", () => {
              const t = el.getAttribute("data-cursor") || "";
              label.textContent = t;
              root.classList.add("is-active");
              if (t) root.classList.add("has-label");
            });
            el.addEventListener("mouseleave", () => root.classList.remove("is-active", "has-label"));
          });
          document.querySelectorAll("a, button, [role='button'], input, textarea, select, label").forEach((el) => {
            if (el.__ljLink) return;
            el.__ljLink = true;
            el.addEventListener("mouseenter", () => root.classList.add("is-link"));
            el.addEventListener("mouseleave", () => root.classList.remove("is-link"));
          });
        }
        bind();
        new MutationObserver(bind).observe(document.body, { childList: true, subtree: true });
      })();
    </script>

    <!-- GSAP scroll orchestration -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

      gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          e.preventDefault();
          const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
          if (href) {
            gsap.to(window, {
              duration: 0.85,
              scrollTo: { y: href, offsetY: 56 },
              ease: 'power3.inOut',
            });
          }
        });
      });

      // Chapter heads use DS CSS transitions — just add .in class via ScrollTrigger
      gsap.utils.toArray<HTMLElement>('.chapter__head').forEach((el) => {
        ScrollTrigger.create({
          trigger: el,
          start: 'top 88%',
          onEnter: () => el.classList.add('in'),
        });
      });

      // Generic .reveal — fast and subtle
      gsap.utils.toArray<HTMLElement>('.reveal').forEach((el) => {
        gsap.fromTo(
          el,
          { opacity: 0, y: 16 },
          {
            opacity: 1, y: 0, duration: 0.35, ease: 'power3.out',
            scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none none' },
          }
        );
      });

      // Staggered children — .reveal-stagger wrapper
      gsap.utils.toArray<HTMLElement>('.reveal-stagger').forEach((container) => {
        gsap.fromTo(
          Array.from(container.children),
          { opacity: 0, y: 12 },
          {
            opacity: 1, y: 0, duration: 0.3, ease: 'power3.out', stagger: 0.05,
            scrollTrigger: { trigger: container, start: 'top 88%', toggleActions: 'play none none none' },
          }
        );
      });

      // ── Scroll progress bar ──
      const bar = document.createElement('div');
      bar.style.cssText = 'position:fixed;top:0;left:0;height:2px;width:0%;background:var(--pink);z-index:99999;pointer-events:none;transition:width 80ms linear;';
      document.body.appendChild(bar);
      window.addEventListener('scroll', () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = (window.scrollY / total * 100) + '%';
      }, { passive: true });

      // ── Dark mode toggle ──
      const toggle = document.createElement('button');
      toggle.setAttribute('aria-label', 'Toggle dark mode');
      toggle.style.cssText = 'position:fixed;bottom:24px;right:24px;width:38px;height:38px;background:var(--ink);color:var(--paper);border:none;border-radius:50%;font-size:15px;z-index:1000;display:flex;align-items:center;justify-content:center;transition:transform 180ms,background 200ms,color 200ms;';
      const savedTheme = localStorage.getItem('lj-theme');
      const isDarkInit = savedTheme === 'dark';
      if (isDarkInit) document.documentElement.setAttribute('data-theme', 'dark');
      toggle.textContent = isDarkInit ? '◑' : '◐';
      toggle.addEventListener('mouseenter', () => { toggle.style.transform = 'scale(1.12)'; });
      toggle.addEventListener('mouseleave', () => { toggle.style.transform = 'scale(1)'; });
      toggle.addEventListener('click', () => {
        const dark = document.documentElement.getAttribute('data-theme') === 'dark';
        document.documentElement.setAttribute('data-theme', dark ? '' : 'dark');
        toggle.textContent = dark ? '◐' : '◑';
        localStorage.setItem('lj-theme', dark ? 'light' : 'dark');
      });
      document.body.appendChild(toggle);
    </script>
  </body>
</html>
